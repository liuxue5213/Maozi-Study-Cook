# ============================================
# 麦子学厨 - 后端环境变量配置
# 复制此文件为 .env 并填写实际值
# ============================================

# 应用配置
NODE_ENV=development
PORT=60135
CORS_ORIGIN=*

# 文件上传
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# 数据库 MySQL
# 生产环境请使用专用数据库用户（参考 docs/DEPLOYMENT.md 创建 maozi 用户）
# 本地开发: mysql://root:your_password@localhost:3306/maozi_cook
# 生产环境: mysql://maozi:your_password@localhost:3306/maozi_cook
DATABASE_URL="mysql://maozi:your_password@localhost:3306/maozi_cook"

# Redis
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=

# JWT 认证
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# AI 服务（阿里云百炼/通义千问）
AI_API_KEY=your-ai-api-key
AI_BASE_URL=https://dashscope.aliyuncs.com/api/v1
AI_VISION_MODEL=qwen-vl-plus
AI_TEXT_MODEL=qwen-plus
AI_DETAIL_MODEL=qwen-plus
