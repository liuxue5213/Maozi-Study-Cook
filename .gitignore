# ============================================
# 麦子学厨 - Git 全局忽略规则
# ============================================

# 依赖
node_modules/
.pnpm-store/

# 构建产物
dist/
build/
.expo/
web-build/

# 环境变量（敏感信息）
.env
.env.local
.env.*.local
.env.production

# 上传文件（用户数据）
backend/uploads/*
!backend/uploads/.gitkeep

# 日志
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 操作系统
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# 临时文件
*.tmp
*.temp
.cache/

# 测试覆盖率
coverage/
.nyc_output/
